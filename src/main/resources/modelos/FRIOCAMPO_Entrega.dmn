na&quot;</text></literalExpression></contextEntry></context></decision><businessKnowledgeModel id="_E819D7C1-9BFA-4E02-91BB-0D3E7D4AB9EE" name="Precio por palé"><variable id="_C6A09EFB-864D-4486-A560-311AC26B92AD" name="Precio por palé" typeRef="number"/><encapsulatedLogic id="_B53A060E-27B9-45D5-8128-5C0F8A3F3216" kind="FEEL"><formalParameter id="_65AD4671-D180-4160-BA47-7E2A7ECEB849" name="tipo" typeRef="tTipoProducto"/><formalParameter id="_F6FB1A34-3992-42E5-A18A-82B2F4DA4DA2" name="zona" typeRef="tZona"/><decisionTable id="_AEB1AC94-1FD2-4085-9699-EC563F259FD4" hitPolicy="UNIQUE" typeRef="number"><input id="_C5167C90-A8EC-46D9-A46D-2FB056ABDAB0" label="tipo"><inputExpression id="_DAA1408F-5844-4498-94BD-671411C747C7" typeRef="tTipoProducto"><text>tipo</text></inputExpression></input><input id="_468800EF-6ACD-4401-BDDC-EDD223AC6CA2" label="zona"><inputExpression id="_1E8CC2A6-5E2A-4AD4-A95F-679BDA832DE2" typeRef="tZona"><text>zona</text></inputExpression></input><output id="_072C80EA-D6EE-4241-8245-64D1A733080A"></output><annotation name="Anotación"/><rule id="_860AF490-806B-4F48-A7CE-3CBF1C69572A"><inputEntry id="_F04665C5-D768-4FCA-BCDF-A499DF72E475"><text>&quot;Seco&quot;</text></inputEntry><inputEntry id="_4B15AD9F-1FB5-45BE-AA16-2F6BEE5DB771"><text>&quot;Zona 1&quot;</text></inputEntry><outputEntry id="_9A3D0016-5CF2-4AF0-A79F-A538A5253DD6"><text>18</text></outputEntry><annotationEntry><text></text></annotationEntry></rule><rule id="_BF569FDF-5C45-4804-A034-5FDBD382CD31"><inputEntry id="_F0166DFD-8DCB-41C6-982D-5C20E09DFA1F"><text>&quot;Seco&quot;</text></inputEntry><inputEntry id="_D89B8643-903C-492F-B633-815B4A0D8B43"><text>&quot;Zona 2&quot;</text></inputEntry><outputEntry id="_ECE1E89A-EC0C-41E6-8AEA-A8B3B0EEA3A7"><text>25</text></outputEntry><annotationEntry><text></text></annotationEntry></rule><rule id="_5D152711-97E5-42F9-AADB-5B66AC000238"><inputEntry id="_D54ED9B6-701D-456C-A0D6-E4BCA5B45C00"><text>&quot;Seco&quot;</text></inputEntry><inputEntry i
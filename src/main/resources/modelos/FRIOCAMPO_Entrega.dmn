o&quot;, &quot;Refrigerado&quot;, &quot;Congelado&quot;], l.tipo) and l.palés instance of number and l.palés &gt; 0)</text></literalExpression></decision><decision id="_D9DE49D0-0CA5-4AEC-BF9E-92D61B053A31" name="Zona de reparto"><variable id="_7D7EDA7D-E60C-4CD4-AE36-D775971E2883" name="Zona de reparto" typeRef="tZona"/><informationRequirement id="_3EEDE081-EFED-4F12-BC8F-B446ED8AFC84"><requiredInput href="#_C3C32E5D-1E36-4B14-869B-8541E427D001"/></informationRequirement><decisionTable id="_0E249EF3-386F-4453-9C56-72B5F28F2DF4" hitPolicy="UNIQUE" typeRef="tZona"><input id="_B9B6790B-6C0C-44F8-8A66-6C0B6FE186C9" label="Pedido.provincia destino"><inputExpression id="_5BDC3B1E-799F-426F-97CB-1735522105B9" typeRef="string"><text>Pedido.provincia destino</text></inputExpression></input><output id="_356DB9C2-098D-452F-90DD-076B788FEEA5"></output><annotation name="Anotación"/><rule id="_B25C42AD-5E2D-43F4-8EA7-7878D541F035"><inputEntry id="_5F9276C9-D2F8-414F-AE31-B79E922A63E3"><text>&quot;Cádiz&quot;,&quot;Sevilla&quot;,&quot;Huelva&quot;</text></inputEntry><outputEntry id="_61449812-21FC-4EF8-B56C-A84B22D569C8"><text>&quot;Zona 1&quot;</text></outputEntry><annotationEntry><text>Andalucía occidental</text></annotationEntry></rule><rule id="_BF06B382-4FBC-49FE-8CC4-C4E306A098DD"><inputEntry id="_72549087-39FD-442D-941A-9AE3B09A69FA"><text>&quot;Málaga&quot;,&quot;Córdoba&quot;,&quot;Granada&quot;,&quot;Jaén&quot;,&quot;Almería&quot;</text></inputEntry><outputEntry id="_7F10C7D6-D48E-4D12-B699-7DED7CF17B96"><text>&quot;Zona 2&quot;</text></outputEntry><annotationEntry><text>Andalucía oriental</text></annotationEntry></rule><rule id="_A35D89ED-2BC6-4802-8840-D2BECFB3085E"><inputEntry id="_65DEE797-3EBF-4A1F-8A56-5AA0C1AC7EE6"><text>not(&quot;Cádiz&quot;,&quot;Sevilla&quot;,&quot;Huelva&quot;,&quot;Málaga&quot;,&quot;Córdoba&quot;,&quot;Granada&quot;,&quot;Jaén&quot;,&quot;Almería&quot;)</text></inputEntry><outputEntry id="_964C2F39-2370-4BC1-B84D-3F090594B6E3"><text>&quot;Zona 3&quot;</text></outputEntry><annotationEntry><text>Resto de destinos</text></annotationEntry></rule></decisionTable></decision><decision id="_9062F77C-0385-4DEE-AE1B-722487443507" name="Días de antelación"><variable id="_E94441EE-76B8-405A-947B-A357F0ACD3E4" name="Días de antelación" typeRef="number"/><informationRequirement id="_08E3A531-3EC2-4BC0-A626-B24497A287AF"><requiredInput href="#_C3C32E5D-1E36-4B14-869B-8541E427D001"/></informationRequirement><literalExpression id="_04049D7E-1972-4642-B447-0D9DDD14AA38" typeRef="number"><text>(Pedido.fecha entrega solicitada - Pedido.fecha pedido).days</text></literalExpression></decision><decision id="_856891CA-07AC-4C51-B662-C0FDDDEEBD92" name="Total de palés"><variable id="_98EB89EF-4C38-4BFC-B952-D978A1BA5440" name="Total de palés" typeRef="number"/><informationRequirement id="_91A2BD58-1497-430D-AE0A-3B69CE262B38"><requiredInput href="#_C3C32E5D-1E36-4B14-869B-8541E427D001"/></informationRequirement><informationRequirement id="_5D4DBB67-5957-4C45-94FB-085F0990F1BF"><requiredDecision href="#_873F87BF-BD06-4486-9458-4856A60FF195"/></informationRequirement><literalExpression id="_DFE76213-F452-4B27-BCD6-0DD93A3E14ED" typeRef="number"><text>if Datos completos then sum(Pedido.líneas.palés) else null</text></literalExpression></decision><decision id="_FF0DF1EA-833D-4C1C-80CA-5E7CA50D3FF6" name="Lleva congelado"><variable id="_772FA23B-4BBC-4C57-B786-4A48A0C7E72A" name="Lleva congelado" typeRef="boolean"/><informationRequirement id="_1DBCD76D-A1D3-440E-8084-C66A9490467F"><requiredInput href="#_C3C32E5D-1E36-4B14-869B-8541E427D001"/></informationRequirement><literalExpression id="_06B5C1D9-25D5-4465-A7ED-37B662054E31" typeRef="boolean"><text>some l in Pedido.líneas satisfies l.tipo = &quot;Congelado&quot;</text></literalExpression></decision><decision id="_BC6F76B2-4EE7-45C0-B436-B897D1EF064E" name="Entrega en viernes"><variable id="_0966CB21-078C-42C3-B343-14FF12449ED4" name="Entrega en viernes" typeRef="boolean"/><informationRequirement id="_DDC1421F-586E-47DB-8D03-7308FA09A505"><requiredInput href="#_C3C32E5D-1E36-4B14-869B-8541E427D001"/></informationRequirement><literalExpression id="_8A6DFB4E-FB56-427D-9D70-D3596D54D722" typeRef="boolean"><text>day of week(Pedido.fecha entrega solicitada) = &quot;Friday&quot;</text></literalExpression></decision><decision id="_F4482C65-6520-499F-A044-A1B0BB97E0D2" name="Días mínimos de antelación"><variable id="_5B749BCF-9237-4F56-A69D-7478AFD2890D" name="Días mínimos de antelación" typeRef="number"/><informationRequirement id="_E92F33A4-DE10-4568-B238-B4EB1C293F7A"><requiredDecision href="#_D9DE49D0-0CA5-4AEC-BF9E-92D61B053A31"/></informationRequirement><informationRequirement id="_77E47547-C464-45EE-B88F-CEF04B0567B0"><requiredDecision href="#_FF0DF1EA-833D-4C1C-80CA-5E7CA50D3FF6"/></informationRequirement><decisionTable id="_F2558C3E-9F04-49DE-A9EB-6ABAFEA9D843" hitPolicy="UNIQUE" typeRef="number"><input id="_C23912FA-BF77-4E4B-9A3F-49BC7611CB24" label="Zona de reparto"><inputExpression id="_C04A7CFB-D149-431E-B2A1-DE4133140F27" typeRef="tZona"><text>Zona de reparto</text></inputExpression></input><input id="_89A5127F-99AA-4006-83B3-F5ADD4BA824F" label="Lleva congelado"><inputExpression id="_9152B9C6-0A3D-4E73-9797-97B4663845A1" typeRef="boolean"><text>Lleva congelado</text></inputExpression></input><output id="_6329EFB3-4638-42C6-BA12-D9567BF2A8E2"></output><annotation name="Anotación"/><rule id="_6AFB2C19-D5EB-4C33-BFF2-2783193B09DB"><inputEntry id="_3917E92F-C145-441D-81D4-5B38EBC0ECD0"><text>&quot;Zona 1&quot;</text></inputEntry><inputEntry id="_BBA7F9AE-0EBF-403D-88B0-687D054484E0"><text>-</text></inputEntry><outputEntry id="_8642EDEC-671B-4C86-A489-E82AC0B1A172"><text>1</text></outputEntry><annotationEntry><text></text></annotationEntry></rule><rule id="_34CF0D04-43AA-4CA0-A835-4F1152CA6EFD"><inputEntry id="_2D4A7CE0-7C84-4AC3-9D6F-023FF3AF04F7"><text>&quot;Zona 2&quot;</text></inputEntry><inputEntry id="_2502D771-2C6C-4222-B5E9-F0F6F4A43BF2"><text>-</text></inputEntry><outputEntry id="_ED6295AB-72AD-4BC2-B568-EAED04AAA954"><text>2</text></outputEntry><annotationEntry><text></text></annotationEntry></rule><rule id="_345FE42F-3743-4403-BE37-DC8FDB69D147"><inputEntry id="_D32FA54A-DACA-4601-89BF-01FC3103709C"><text>&quot;Zona 3&quot;</text></inputEntry><inputEntry id="_F06CC63D-AC37-4AC2-986F-24FEE2E2EB0D"><text>false</text></inputEntry><outputEntry id="_05220470-0890-4FC0-887B-E21611F0CAB0"><text>2</text></outputEntry><annotationEntry><text></text></annotationEntry></rule><rule id="_00B6BB15-5658-420A-9C71-04CE84624555"><inputEntry id="_D9A1BDDC-5199-47BD-91EC-B4DB491CD39F"><text>&quot;Zona 3&quot;</text></inputEntry><inputEntry id="_95B2D25B-18A3-4CDA-BFA0-02577F98C1B6"><text>true</text></inputEntry><outputEntry id="_CFF30A5D-D6BB-4442-9A7A-5E564E096B49"><text>3</text></outputEntry><annotationEntry><text>El congelado a larga distancia necesita doble frigorífico</text></annotationEntry></rule></decisionTable></decision><decision id="_098A86D2-C9D7-489A-80B5-DA389ED7DA95" name="Entrega viable"><variable id="_DBB511AD-6831-49BA-95CD-A97E61CB13B0" name="Entrega viable" typeRef="boolean"/><informationRequirement id="_43158CAB-5879-47B1-91A4-1A18E251AA54"><requiredDecision href="#_856891CA-07AC-4C51-B662-C0FDDDEEBD92"/></informationRequirement><informationRequirement id="_F467AE97-97FC-4C09-AB5A-1942EF6CF093"><requiredDecision href="#_9062F77C-0385-4DEE-AE1B-722487443507"/></informationRequirement><informationRequirement id="_A505682E-6C98-4868-A640-E74E92D16EB5"><requiredDecision href="#_F4482C65-6520-499F-A044-A1B0BB97E0D2"/></informationRequirement><literalExpression id="_A6413D28-E31E-4408-AFCB-9183C35F0DDF" typeRef="boolean"><text>Total de palés &lt;= 24 and Días de antelación &gt;= Días mínimos de antelación</text></literalExpression></decision><decision id="_D8C20CBA-246C-4170-8B43-10060EC00431" name="Coste del transporte"><variable id="_91F3E83A-5736-48F6-A4DC-322C15EF580B" name="Coste del transporte" typeRef="number"/><informationRequirement id="_BC6D796C-3EA1-4F6D-960D-237CE5D240AE"><requiredDecision href="#_873F87BF-BD06-4486-9458-4856A60FF195"/></informationRequirement><informationRequirement id="_3F16A19D-3FB0-4C3C-A4FE-069F2584EBF3"><requiredInput href="#_C3C32E5D-1E36-4B14-869B-8541E427D001"/></informationRequirement><informationRequirement id="_258FF231-B2E1-45F6-A674-CE1BFB91980A"><requiredDecision href="#_D9DE49D0-0CA5-4AEC-BF9E-92D61B053A31"/></informationRequirement><knowledgeRequirement id="_E3DBBE58-7407-4580-B8BE-76822D82061B"><requiredKnowledge href="#_E819D7C1-9BFA-4E02-91BB-0D3E7D4AB9EE"/></knowledgeRequirement><literalExpression id="_A73E359D-A76C-478C-9192-A7FBE1CC5A6E" typeRef="number"><text>if Datos completos then sum(for l in Pedido.líneas return l.palés * Precio por palé(l.tipo, Zona de reparto)) else null</text></literalExpression></decision><decision id="_8DB168C6-AFF0-4D8B-A572-C792584FD9E6" name="Planificación de la entrega"><variable id="_45EE813A-C800-42D0-B458-A6C432F81E4B" name="Planificación de la entrega" typeRef="tPlanificacion"/><informationRequirement id="_937FFE04-9402-4752-81F9-2C9A5698E490"><requiredDecision href="#_873F87BF-BD06-4486-9458-4856A60FF195"/></informationRequirement><informationRequirement id="_E388E90F-5B17-42A2-A5FB-FC82554BF674"><requiredDecision href="#_D9DE49D0-0CA5-4AEC-BF9E-92D61B053A31"/></informationRequirement><informationRequirement id="_24494AE6-663C-4F8F-B818-E11844DC04D9"><requiredDecision href="#_9062F77C-0385-4DEE-AE1B-722487443507"/></informationRequirement><informationRequirement id="_E7FB33D1-75F3-4589-B683-B13F88F0E6E5"><requiredDecision href="#_098A86D2-C9D7-489A-80B5-DA389ED7DA95"/></informationRequirement><informationRequirement id="_1D623BA3-D94B-4119-B376-8251937EDF39"><requiredDecision href="#_BC6F76B2-4EE7-45C0-B436-B897D1EF064E"/></informationRequirement><informationRequirement id="_BC06F366-A2AE-4532-84DD-6A6B1BC60817"><requiredDecision href="#_D8C20CBA-246C-4170-8B43-10060
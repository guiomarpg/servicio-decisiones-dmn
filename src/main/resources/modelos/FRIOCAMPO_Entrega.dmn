co&quot;, &quot;Refrigerado&quot;, &quot;Congelado&quot;], l.tipo) and l.palés instance of number and l.palés &gt; 0)</text></literalExpression></decision><decision id="_5CB4F517-9D63-43EC-805C-F5BCC5F9EED8" name="Zona de reparto"><variable id="_61729AAB-0623-48AB-93ED-D079FFD6A630" name="Zona de reparto" typeRef="tZona"/><informationRequirement id="_74F95094-B60F-4E90-BE18-1333197EF3AA"><requiredInput href="#_C435C8EE-6CFF-4BAF-A409-9E184F2CF2C0"/></informationRequirement><decisionTable id="_3EDBD3A1-6C7A-4802-84B0-37E7C704973F" hitPolicy="UNIQUE" typeRef="tZona"><input id="_77584E7D-A951-4E52-BEF2-65398BDAC587" label="Pedido.provincia destino"><inputExpression id="_C149B94D-0A94-4788-8033-1BC7D0854786" typeRef="string"><text>Pedido.provincia destino</text></inputExpression></input><output id="_9013C7C1-308E-4FC7-9DD9-C3AC9EFC23BC"></output><annotation name="Anotación"/><rule id="_3B2F3B0C-A398-46D5-85E0-6FA97F95FF1D"><inputEntry id="_3105F28A-3AB8-4D29-A447-967B216BE1E3"><text>&quot;Cádiz&quot;,&quot;Sevilla&quot;,&quot;Huelva&quot;</text></inputEntry><outputEntry id="_C5B0835A-CC6C-4B15-9051-C00ADDD6B6F2"><text>&quot;Zona 1&quot;</text></outputEntry><annotationEntry><text>Andalucía occidental</text></annotationEntry></rule><rule id="_11B2C4FE-1F8A-475B-BF8B-6E293CB4262A"><inputEntry id="_E08429BB-4996-4D0D-9C8F-15245E5D2988"><text>&quot;Málaga&quot;,&quot;Córdoba&quot;,&quot;Granada&quot;,&quot;Jaén&quot;,&quot;Almería&quot;</text></inputEntry><outputEntry id="_1A6549E7-D04F-4CF8-8077-FA168301D916"><text>&quot;Zona 2&quot;</text></outputEntry><annotationEntry><text>Andalucía oriental</text></annotationEntry></rule><rule id="_29249EAE-D7A9-408A-AE4F-25B928864743"><inputEntry id="_D9C56E47-EB7E-41A8-9131-9341886B5842"><text>not(&quot;Cádiz&quot;,&quot;Sevilla&quot;,&quot;Huelva&quot;,&quot;Málaga&quot;,&quot;Córdoba&quot;,&quot;Granada&quot;,&quot;Jaén&quot;,&quot;Almería&quot;)</text></inputEntry><outputEntry id="_042B2802-5CFC-4EE2-BE55-A40C5C952E53"><text>&quot;Zona 3&quot;</text></outputEntry><annotationEntry><text>Resto de destinos</text></annotationEntry></rule></decisionTable></decision><decision id="_E4154919-6C15-4CAA-8A44-F7DE2673E7DF" name="Días de antelación"><variable id="_7162748A-582A-422A-BEBA-4A4488ED5DB7" name="Días de antelación" typeRef="number"/><informationRequirement id="_1B718CF3-FE49-4716-A5CA-65D410002D79"><requiredInput href="#_C435C8EE-6CFF-4BAF-A409-9E184F2CF2C0"/></informationRequirement><literalExpression id="_22996732-3114-47D2-B5B9-6E38845CBD5E" typeRef="number"><text>(Pedido.fecha entrega solicitada - Pedido.fecha pedido).days</text></literalExpression></decision><decision id="_77CBBECE-B675-4F72-A0F2-79C43110BD0A" name="Total de palés"><variable id="_3506F689-27E5-4B8C-922E-0B69CCAA6F4F" name="Total de palés" typeRef="number"/><informationRequirement id="_73A220F8-84A2-4FA3-9B0B-768B0CEBAF4B"><requiredInput href="#_C435C8EE-6CFF-4BAF-A409-9E184F2CF2C0"/></informationRequirement><informationRequirement id="_C31EB8E9-F781-45E0-AB9D-ABBEE729A32C"><requiredDecision href="#_66A82BA0-144E-4920-8EFE-61C5C2292A52"/></informationRequirement><literalExpression id="_32130AB8-DBB3-4250-A7B5-4193FF8B5F0E" typeRef="number"><text>if Datos completos then sum(Pedido.líneas.palés) else null</text></literalExpression></decision><decision id="_C9FE2A57-8805-4369-928E-A6CB2B3E83BC" name="Lleva congelado"><variable id="_21E78D19-33E9-4278-8C80-971698EB804B" name="Lleva congelado" typeRef="boolean"/><informationRequirement id="_D2798BDC-5A64-4B73-873C-0DC6D8D91A0A"><requiredInput href="#_C435C8EE-6CFF-4BAF-A409-9E184F2CF2C0"/></informationRequirement><literalExpression id="_64A96E26-9DA9-4C64-ADAD-8D08245D65BC" typeRef="boolean"><text>some l in Pedido.líneas satisfies l.tipo = &quot;Congelado&quot;</text></literalExpression></decision><decision id="_3BD16609-3920-40DF-8088-09CFC7F1BCF4" name="Entrega en viernes"><variable id="_45BA6410-AC61-4284-B69B-9B6EA5D1D006" name="Entrega en viernes" typeRef="boolean"/><informationRequirement id="_8289F5D3-6ED5-40B2-91AD-B3C5E3743A9D"><requiredInput href="#_C435C8EE-6CFF-4BAF-A409-9E184F2CF2C0"/></informationRequirement><literalExpression id="_A40964DD-046B-495F-8D8F-CC12CBF3A4F4" typeRef="boolean"><text>day of week(Pedido.fecha entrega solicitada) = &quot;Friday&quot;</text></literalExpression></decision><decision id="_9CBE8E8B-E6E5-481D-AF9E-9261ADD69B91" name="Días mínimos de antelación"><variable id="_AF3C13D6-8C96-4772-B572-CA5218D3FD74" name="Días mínimos de antelación" typeRef="number"/><informationRequirement id="_B3D6A7B7-3CAD-4F96-8133-B0BE848D4784"><requiredDecision href="#_5CB4F517-9D63-43EC-805C-F5BCC5F9EED8"/></informationRequirement><informationRequirement id="_2F273FD6-A022-44BC-A574-5E4FDC5C7F20"><requiredDecision href="#_C9FE2A57-8805-4369-928E-A6CB2B3E83BC"/></informationRequirement><decisionTable id="_E55B1338-8FB7-4985-8E20-9F97EE7A354E" hitPolicy="UNIQUE" typeRef="number"><input id="_D041C1EF-4704-4374-BD31-D11600897596" label="Zona de reparto"><inputExpression id="_3F313432-2FA9-4994-8415-D96E2C584299" typeRef="tZona"><text>Zona de reparto</text></inputExpression></input><input id="_645F4D1E-ABC6-42EF-9BA0-018622C3443C" label="Lleva congelado"><inputExpression id="_E28B4398-BD4F-4267-A8DF-E92DF4FA5AE3" typeRef="boolean"><text>Lleva congelado</text></inputExpression></input><output id="_AB722BA5-27B2-4182-B8FC-C2448A57F629"></output><annotation name="Anotación"/><rule id="_7134FB18-13F6-4076-AB69-D1A3C09C663D"><inputEntry id="_D103A98A-581D-446E-9897-A3AA13A28152"><text>&quot;Zona 1&quot;</text></inputEntry><inputEntry id="_E6A6AFE2-55E9-4E59-9EB9-E689340F624D"><text>-</text></inputEntry><outputEntry id="_A940FB75-2053-436F-8FE0-AE96499B112C"><text>1</text></outputEntry><annotationEntry><text></text></annotationEntry></rule><rule id="_45991A73-E507-4196-AB1A-6248507CDF16"><inputEntry id="_B43E3ED4-8191-4E0C-B7DB-2173E7F28FF4"><text>&quot;Zona 2&quot;</text></inputEntry><inputEntry id="_D7BB45E8-0923-4483-9E69-E447A64CA2DE"><text>-</text></inputEntry><outputEntry id="_87606FAD-DF4F-4EB7-A8ED-5D9C8F8A6BD8"><text>2</text></outputEntry><annotationEntry><text></text></annotationEntry></rule><rule id="_E03DEBCE-B80D-4658-8C53-F8DB5F2E69F0"><inputEntry id="_75D871AE-1F40-4AE1-BFCD-B0A5BA3C630E"><text>&quot;Zona 3&quot;</text></inputEntry><inputEntry id="_B3852429-C46A-4995-887E-8D69583879CE"><text>false</text></inputEntry><outputEntry id="_51BFA534-33AE-43DE-A991-18F074B0CC58"><text>2</text></outputEntry><annotationEntry><text></text></annotationEntry></rule><rule id="_43DA9422-39E5-4730-95B4-6CABF89AA738"><inputEntry id="_2FF2313F-9059-48D6-B6E1-DDD14083E20A"><text>&quot;Zona 3&quot;</text></inputEntry><inputEntry id="_22B96C51-359D-42FC-A2BE-D81F590438E5"><text>true</text></inputEntry><outputEntry id="_61E22BA3-BD9E-43B8-A7CC-76C4449FC581"><text>3</text></outputEntry><annotationEntry><text>El congelado a larga distancia necesita doble frigorífico</text></annotationEntry></rule></decisionTable></decision><decision id="_114E008D-225B-4520-AFEF-BB02FE45107D" name="Entrega viable"><variable id="_33470183-2259-4AAC-931D-DD2616DF2BAD" name="Entrega viable" typeRef="boolean"/><informationRequirement id="_30D624F5-42AE-4569-9595-81219312A205"><requiredDecision href="#_77CBBECE-B675-4F72-A0F2-79C43110BD0A"/></informationRequirement><informationRequirement id="_8AB19994-A112-4CBC-A090-30A0102FBBAE"><requiredDecision href="#_E4154919-6C15-4CAA-8A44-F7DE2673E7DF"/></informationRequirement><informationRequirement id="_D3387AEE-B09D-4628-A672-C8D579098986"><requiredDecision href="#_9CBE8E8B-E6E5-481D-AF9E-9261ADD69B91"/></informationRequirement><literalExpression id="_AC18C10C-BF35-47B4-90BE-BBEC5E7AF77F" typeRef="boolean"><text>Total de palés &lt;= 24 and Días de antelación &gt;= Días mínimos de antelación</text></literalExpression></decision><decision id="_E11ADE99-EE82-4A9B-9E91-D993883D6EA3" name="Coste del transporte"><variable id="_0C6CA0A4-2FE1-428B-A003-4BFC95247B3A" name="Coste del transporte" typeRef="number"/><informationRequirement id="_94FEC6F2-8F1E-49C1-8412-4E5F494FF353"><requiredDecision href="#_66A82BA0-144E-4920-8EFE-61C5C2292A52"/></informationRequirement><informationRequirement id="_1D07C0CB-32F3-41AF-8F5F-809B082FA136"><requiredInput href="#_C435C8EE-6CFF-4BAF-A409-9E184F2CF2C0"/></informationRequirement><informationRequirement id="_A5724DD9-5287-49C0-A5E9-E48689E263E1"><requiredDecision href="#_5CB4F517-9D63-43EC-805C-F5BCC5F9EED8"/></informationRequirement><knowledgeRequirement id="_85DA21BD-B9A8-4F96-B89A-FD628AB58129"><requiredKnowledge href="#_A7D22F1B-FB2D-4C83-AAC4-5BEA377C83B7"/></knowledgeRequirement><literalExpression id="_25458DF9-2F7A-407A-8036-6B262703FEA5" typeRef="number"><text>if Datos completos then sum(for l in Pedido.líneas return l.palés * Precio por palé(l.tipo, Zona de reparto)) else null</text></literalExpression></decision><decision id="_DA0A4C17-89C7-4936-A23A-1F03CE637B06" name="Planificación de la entrega"><variable id="_E4E25C20-A0FE-4580-A884-BA3D66F3B226" name="Planificación de la entrega" typeRef="tPlanificacion"/><informationRequirement id="_0BC70A51-E742-439D-8C09-D670C15736EC"><requiredDecision href="#_66A82BA0-144E-4920-8EFE-61C5C2292A52"/></informationRequirement><informationRequirement id="_F72FA87F-C805-465E-83FD-D94E6C5ED4FE"><requiredDecision href="#_5CB4F517-9D63-43EC-805C-F5BCC5F9EED8"/></informationRequirement><informationRequirement id="_F8AE0272-3378-4CAE-9BE5-16B59266BD66"><requiredDecision href="#_E4154919-6C15-4CAA-8A44-F7DE2673E7DF"/></informationRequirement><informationRequirement id="_04807721-5C43-430C-B781-8EA34B0924BC"><requiredDecision href="#_114E008D-225B-4520-AFEF-BB02FE45107D"/></informationRequirement><informationRequirement id="_66FEE86D-E971-4353-9723-B39ABCB36A81"><requiredDecision href="#_3BD16609-3920-40DF-8088-09CFC7F1BCF4"/></informationRequirement><informationRequirement id="_212A98B2-11A4-4C30-B108-061649097D29"><requiredDecision href="#_E11ADE99-EE82-4A9B-9E91-D993
-48D2-AB93-1BD6D0F955E0"><text>true</text></inputEntry><outputEntry id="_B3B7275D-28E4-48D1-86CF-E188F35C92FB"><text>3</text></outputEntry><annotationEntry><text>El congelado a larga distancia necesita doble frigorífico</text></annotationEntry></rule></decisionTable></decision><decision id="_9CD0DD0B-C460-4130-B7B2-63A2042CCDA0" name="Entrega viable"><variable id="_B36A761F-7D9B-491F-A159-70F4D88B2998" name="Entrega viable" typeRef="boolean"/><informationRequirement id="_618257A0-59FC-4025-B33A-6CBF25C6B126"><requiredDecision href="#_5BB3C6AE-2DD3-49B0-8D51-FE9F41750315"/></informationRequirement><informationRequirement id="_D82198F0-CB83-42F7-AF78-A4492CFB2907"><requiredDecision href="#_AE289C07-EA5D-4B27-8E0C-C52AB1EEF67C"/></informationRequirement><informationRequirement id="_3D51B3B8-944E-4ACC-B22E-DACFA22F5935"><requiredDecision href="#_94B7DE7B-A633-4306-8F7B-22A1685B3778"/></informationRequirement><literalExpression id="_1FA70EDC-5ADA-453C-8C6F-0158584EC674"><text>Total de palés &lt;= 24 and Días de antelación &gt;= Días mínimos de antelación</text></literalExpression></decision><decision id="_0D9436A9-CC19-472E-9B72-943C1A5085EB" name="Coste del transporte"><variable id="_D0C3650B-A9B3-4C6A-81A5-F828E0968138" name="Coste del transporte" typeRef="number"/><informationRequirement id="_2C3A7570-93C1-46B2-B834-AE0A53E30CD3"><requiredInput href="#_8C24ABD9-8B66-4353-AC2B-F19F53D62D5E"/></informationRequirement><informationRequirement id="_A76F50F3-60BB-41CB-BBA7-80BBDA6F0D1C"><requiredDecision href="#_598B102C-A560-4B4D-A3FD-8CC8048BF3FD"/></informationRequirement><knowledgeRequirement id="_8F856DC4-4607-4805-8807-A8152A3B6689"><requiredKnowledge href="#_7AA50714-EA1C-4AD9-95F4-0A983112FF1D"/></knowledgeRequirement><literalExpression id="_7DBEE1AC-9639-4605-97E8-48F5FD0558A2"><text>sum(for l in Pedido.líneas return l.palés * Precio por palé(l.tipo, Zona de reparto))</text></literalExpression></decision><decision id="_F9BBB294-D6F4-417F-A752-00764C599C33" name="Planificación de la entrega"><question>¿Cómo se planifica la entrega del pedido?</question><allowedAnswers>Resultado estructurado para el sistema de transporte</allowedAnswers><variable id="_4DC1788B-719C-4814-8D25-5CF25B463DBD" name="Planificación de la entrega" typeRef="tPlanificacion"/><informationRequirement id="_C327F2BB-35A2-4D4E-A3F3-A639F99829CD"><requiredDecision href="#_598B102C-A560-4B4D-A3FD-8CC8048BF3FD"/></informationRequirement><informationRequirement id="_F59DD703-2662-45C4-A7D9-C447E8C0F741"><requiredDecision href="#_AE289C07-EA5D-4B27-8E0C-C52AB1EEF67C"/></informationRequirement><informationRequirement id="_9A136DEF-4D4E-42BC-86AF-91F011925CB5"><requiredDecision href="#_9CD0DD0B-C460-4130-B7B2-63A2042CCDA0"/></informationRequirement><informationRequirement id="_7C12A363-5CF4-4B83-840F-D8E2A6A43F51"><requiredDecision href="#_15A3F629-E9B5-42BB-A037-30C5A0BBD844"/></informationRequirement><informationRequirement id="_9B247E4A-DAD0-450B-AC2E-5F90F1E425AB"><requiredDecision href="#_0D9436A9-CC19-472E-9B72-943C1A5085EB"/></informationRequirement><informationRequirement id="_26D43D2B-E2CE-425B-B526-7AD4FFC1E9A9"><requiredDecision href="#_5BB3C6AE-2DD3-49B0-8D51-FE9F41750315"/></informationRequirement><context id="_AFDB02F3-AA6D-4F52-BE9E-41853C3D6F28"><contextEntry><variable id="_529FB9C4-46FD-4FF5-BA8F-70006C952AD2" name="zona" typeRef="tZona"/><literalExpression id="_23191CDF-9800-45D3-8C0A-5361634F88BF"><text>Zona de reparto</text></literalExpression></contextEntry><contextEntry><variable id="_3C8E337F-B4CC-41D1-ABF7-85A30B2AB30C" name="días de antelación" typeRef="number"/><literalExpression id="_D2C0A3FD-1CAE-4666-949B-D13C8A66EFCB"><text>Días de antelación</text></literalExpression></contextEntry><contextEntry><variable id="_735B9052-5A69-4350-8E3F-701D68F338BC" name="viable" typeRef="boolean"/><literalExpression id="_0ED0314D-D4D7-4BE9-AEC7-7450D70B9CD3"><text>Entrega viable</text></literalExpression></contextEntry><contextEntry><variable id="_33C04